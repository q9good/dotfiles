#
# Prezto configuration.
# Managed by dotfiles repo — do not edit directly; edit zsh/.zpreztorc in ~/.config.
#

# Color output (auto set to 'no' on dumb terminals).
zstyle ':prezto:*:*' color 'yes'

#
# Module load order matters — dependencies must come first.
#
zstyle ':prezto:load' pmodule \
    'environment' \
    'terminal' \
    'editor' \
    'history' \
    'directory' \
    'spectrum' \
    'utility' \
    'git' \
    'completion' \
    'syntax-highlighting' \
    'history-substring-search' \
    'autosuggestions' \
    'prompt'

#
# Editor
#

# Emacs key bindings.
zstyle ':prezto:module:editor' key-bindings 'emacs'

# Auto convert .... to ../..
zstyle ':prezto:module:editor' dot-expansion 'yes'

#
# History
#

zstyle ':prezto:module:history' histfile "${ZDOTDIR:-$HOME}/.zsh_history"
zstyle ':prezto:module:history' histsize 50000
zstyle ':prezto:module:history' savehist 50000

#
# History Substring Search
#

zstyle ':prezto:module:history-substring-search' case-sensitive 'no'
zstyle ':prezto:module:history-substring-search' fuzzy 'yes'
zstyle ':prezto:module:history-substring-search' unique 'yes'

#
# Prompt
#

# Theme: sorin (clean, shows git status), pure (minimal async), agnoster, powerlevel10k
zstyle ':prezto:module:prompt' theme 'agnoster'
zstyle ':prezto:module:prompt' pwd-length 'short'
zstyle ':prezto:module:prompt' show-return-val 'yes'

#
# Syntax Highlighting
#

zstyle ':prezto:module:syntax-highlighting' highlighters \
    'main' \
    'brackets' \
    'pattern'

#
# Terminal
#

zstyle ':prezto:module:terminal' auto-title 'yes'

#
# Utility
#

# Safe operations: cp, ln, mv, rm prompt before overwrite/delete.
zstyle ':prezto:module:utility' safe-ops 'yes'
