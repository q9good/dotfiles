# Ghostty Configuration
# Location: ~/.config/ghostty/config (macOS/Linux)

# =============================================
# Theme & Appearance
# =============================================
theme = Catppuccin Mocha
copy-on-select = true
background-image-opacity = 0.75
background-opacity = 0.88
background-blur-radius = 12
macos-titlebar-style = transparent
mouse-shift-capture = false
audio-bell = true

# macOS: treat Option key as Alt for keybindings
macos-option-as-alt = true

# =============================================
# Keybindings — Splits
# =============================================
# Alt+\ = vertical split (right), Alt+- = horizontal split (down)
# Consistent with tmux (prefix+\, prefix+-) and nvim (<leader>\, <leader>-)
keybind = alt+backslash=new_split:right
keybind = alt+minus=new_split:down

# Alt+x = close current split (consistent with tmux prefix+x)
keybind = alt+x=close_surface

# C-h/j/k/l = navigate between Ghostty splits.
# "performable:" only consumes the key when goto_split can actually move,
# otherwise the keypress passes through to tmux/nvim.
keybind = performable:ctrl+h=goto_split:left
keybind = performable:ctrl+j=goto_split:down
keybind = performable:ctrl+k=goto_split:up
keybind = performable:ctrl+l=goto_split:right

# =============================================
# Keybindings — Terminal
# =============================================
# Ctrl+Shift+R = full terminal reset (fix garbled output after SSH disconnect)
keybind = ctrl+shift+r=reset
